# Public base URL where the application is hosted (used for payment redirects and callbacks)
APP_URL="https://thecourse.autoshowkampala.com"


# Payment gateway credentials (server-side only)
RONFORD_BASE_URL=""
RONFORD_MERCHANT_KEY=""
RONFORD_SECRET_KEY=""
RONFORD_SUBSCRIPTION_KEY=""

# Host Login credentials (server-side only, configured in Hostinger env vars)
ADMIN_PASSWORD=""
ACCOUNTS_PASSWORD=""

# Optional persistent directory for orders & staff records across redeploys (defaults to .data)
DATA_DIR=""

# Hostinger Email SMTP for sending PDF e-tickets (server-side only)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="connect@autoshowkampala.com"
SMTP_PASS=""
SMTP_FROM="The Course <connect@autoshowkampala.com>"
